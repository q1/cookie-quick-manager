{
  "manifest_version": 3,
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/q1/cookie-quick-manager",
  "author": "Ysard",
  "name": "Cookie Quick Manager",
  "version": "0.6.0",
  "version_name": "0.6.0",
  "default_locale": "en",
  "permissions": ["cookies", "activeTab", "storage", "scripting", "contextualIdentities", "privacy"],
  "host_permissions": ["<all_urls>"],
  "optional_permissions": ["clipboardWrite"],
  "incognito": "spanning",
  "action": {
    "default_title": "Cookie Quick Manager",
    "default_popup": "menu.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "background": {
    "scripts": ["browser-shim.js", "core.js", "platform.js", "api.js", "background-script.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@cookie-quick-manager-q1",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
