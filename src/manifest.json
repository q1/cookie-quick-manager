{
  "manifest_version": 3,
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/ysard/cookie-quick-manager",
  "author": "Ysard",
  "name": "Cookie Quick Manager",
  "version": "0.5rc2",
  "default_locale": "en",
  "permissions": ["cookies", "activeTab", "storage", "browsingData", "scripting"],
  "host_permissions": ["<all_urls>"],
  "optional_permissions": ["clipboardWrite"],
  "incognito": "split",
  "action": {
    "default_title": "Cookie Quick Manager",
    "default_popup": "menu.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
