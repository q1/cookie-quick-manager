{
  "name": "@cookie-loom/extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev:demo": "vite --config vite.demo.config.ts --host 127.0.0.1",
    "dev:chrome": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build -b chrome --mv3 && wxt build -b firefox --mv3",
    "zip": "bun run --cwd ../.. zip",
    "typecheck": "wxt prepare && bun check -p tsconfig.json",
    "lint:firefox": "bun ../../scripts/lint-firefox.mjs"
  },
  "dependencies": {
    "@cookie-loom/core": "*",
    "lucide-react": "0.468.0",
    "preact": "11.0.1",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "vite": "8.3.4",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}
