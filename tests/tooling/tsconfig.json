{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "maxNodeModuleJsDepth": 1,
    "types": ["bun"]
  },
  "include": ["*.test.ts"]
}
